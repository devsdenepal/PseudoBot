# Copy to .env and fill in your own values. NEVER commit real keys.
DISCORD_TOKEN=your_bot_token_here
SERVER_NAME=MyServer

# Optional: enable Google search commands (Custom Search JSON API)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional: enable domain/phone lookup commands
API_NINJAS_KEY=

# Display name used to personalize intent responses
BOT_OWNER_NAME=Dev